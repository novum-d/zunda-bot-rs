@startuml
entity "guild" as guild {
  +guild_id : BIGINT <<PK>>
  --
  *name : VARCHAR(255)
}

entity "guild_member" as member {
  +member_id : BIGINT <<PK>>
  +guild_id : BIGINT <<PK,FK>>
  --
  birth : DATE
  last_notified : DATE
  last_active_at : TIMESTAMPTZ
  last_reminded_at : TIMESTAMPTZ
  next_remind_at : TIMESTAMPTZ
  remind_count : INTEGER
  is_remind_opt_out : BOOLEAN
  is_reminder_opted_in : BOOLEAN
  is_admin : BOOLEAN
}

entity "guild_notification_channel" as notification_channel {
  +guild_id : BIGINT <<PK,FK>>
  +channel_id : BIGINT <<PK>>
}

entity "reminder_sent_message" as reminder_message {
  +guild_id : BIGINT <<PK>>
  +member_id : BIGINT <<PK>>
  +channel_id : BIGINT <<PK>>
  --
  *message_id : BIGINT
}

entity "seven_days_config" as seven_days_config {
  +guild_id : BIGINT <<PK,FK>>
  --
  *channel_id : BIGINT
  *enabled : BOOLEAN
}

entity "seven_days_operator" as seven_days_operator {
  +guild_id : BIGINT <<PK,FK>>
  +operator_kind : VARCHAR(4) <<PK>>
  +operator_id : BIGINT <<PK>>
  --
  *is_admin : BOOLEAN
}

note right of member::is_admin
Guild単位の管理者コマンド権限
7DTD初回setupのbootstrapにも使用する
end note

note right of notification_channel::channel_id
誕生日通知の送信先Channel
end note

note right of reminder_message::message_id
誕生日登録後のリマインド削除に使用する
end note

note right of seven_days_config::channel_id
7DTDコマンドの実行を許可するChannel
end note

note right of seven_days_config::enabled
FALSEの場合は7DTD操作を拒否する
end note

note right of seven_days_operator::operator_kind
user または role
end note

note right of seven_days_operator::is_admin
FALSEはstatusのみ
TRUEはstart/stopと設定変更も許可する
end note

guild ||--o{ member : "所属Member"
guild ||--o{ notification_channel : "通知Channel"
guild ||--o{ seven_days_config : "7DTD設定"
seven_days_config ||--o{ seven_days_operator : "Operator"
member ||--o{ reminder_message : "送信Message"

@enduml
